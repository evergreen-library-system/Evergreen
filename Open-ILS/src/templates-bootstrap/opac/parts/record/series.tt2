[%-
    series_tags = ['440', '490', '800', '810', '811', '830', '694'];
    loc = ctx.search_ou;

BLOCK render_series;
    results = [];

    # Removed code block that was building links using MODS32 data
    # because it was redundant to the links being built with MARCXML data

    # Build related series link entries from MARCXML
    FOR tag IN series_tags;
        FOR node IN ctx.marc_xml.findnodes('//*[@tag="' _ tag _ '"]');
            graphics = [];
            a_search = '';
            a_display = '';
            t_search = '';
            t_display = '';
            display_only1 = '';
            display_only2 = '';

            FOR subfield IN node.childNodes;
                NEXT UNLESS subfield.nodeName == "subfield";
                code = subfield.getAttribute('code');
                IF code == '6';
                    linked_fields = [subfield.textContent()];
                    target_field = node.getAttribute('tag');
                    get_linked_880s;
                END;

                NEXT UNLESS code.match('[a-z]');

                # accommodate entries (allowed with 490s but not 8xx) that have multiple $a subfields
                # by ending current series display line and starting a fresh new line
                IF code.match('a') AND a_search.length > 0;
                    PROCESS create_series_line;
                    a_search = '';
                    a_display = '';
                    t_search = '';
                    t_display = '';
                    display_only1 = '';
                    display_only2 = '';
                END;

                # at this point, we actually have a starting term to use that still includes punctuation
                single_term = subfield.textContent;
                search_term = single_term.replace('[#"^$\+\-,\.:;&|\[\]()<>]', ' ');
                display_term = single_term.replace('[;]') | trim | html;

                IF code.match('a');
                    a_search = search_term;
                    a_display = display_term;
                ELSIF code.match('[b-d]');
                    a_search = a_search _ ' ' _ search_term;
                    a_display = a_display _ ' ' _ display_term;
                ELSIF code.match('[e,j,q,u]');
                    IF display_only1;
                        display_only1 = display_only1 _ ' ' _ display_term;
                    ELSE;
                        display_only1 = display_term;
                    END;
                ELSIF code.match('t');
                    t_search = a_search _ ' ' _ search_term;
                    t_display = display_term;
                ELSE;
                    IF display_only2;
                        display_only2 = display_only2 _ ' ' _ display_term;
                    ELSE;
                        display_only2 = display_term;
                    END;
                END;
            END;

            PROCESS create_series_line;
        END;
    END;

    FOR entry IN results;
    -%]
        <li class='rdetail_series_value'>[% entry %]</li>
    [%- END;
END;
%]

[% BLOCK create_series_line;

    # create series row
    IF a_search;
        a_url = '<a href="' _ mkurl(ctx.opac_root _ '/results',
            { qtype=>'series', query=>a_search }, stop_parms.merge(expert_search_parms, general_search_parms, browse_search_parms, facet_search_parms))
                _ '">' _ a_display _ '</a>';
    END;
    IF t_search;
        t_url = '<a href="' _ mkurl(ctx.opac_root _ '/results',
            { qtype=>'series', query=>t_search }, stop_parms.merge(expert_search_parms, general_search_parms, browse_search_parms, facet_search_parms))
                _ '">' _ t_display _ '</a>';
    END;
    IF display_only1;
        display_only1 = ' ' _ display_only1 _ ' ';
    END;
    IF display_only2;
        display_only2 = ' ' _ display_only2;
    END;

    series_display = a_url _ ' ' _ display_only1 _ t_url _ ' ' _ display_only2;

    FOREACH link880 IN graphics;
        link = link880.value | html;
        series_display = series_display _ '<div class="graphic880"' _ link880.dir _ '>' _ link _ '</div>';
    END;
    results.push(series_display);

END %]

[%- series_anchors = PROCESS render_series;
    IF series_anchors.length > 0; %]
<h3 class='rdetail_related_series'>[% l('Search for related items by series') %]</h3>
<ul class="no-bullets">
    [% series_anchors %]
</ul>
[%- END %]
