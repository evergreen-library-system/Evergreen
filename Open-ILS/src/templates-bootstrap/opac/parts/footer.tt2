[% IF !ctx.is_staff %]
[%# data.tt2 is PROCESSed so its variables land here; the widgets are
    INCLUDEd so they only read them. %]
[%- PROCESS 'opac/parts/footer/data.tt2' -%]
<div id="footer-wrap" class="mt-auto">
<footer id="footer">
    <div class="container-fluid py-4">

        <div class="row">
            [% INCLUDE 'opac/parts/footer/contact.tt2' IF footer_show_contact %]
            [% INCLUDE 'opac/parts/footer/hours.tt2' IF footer_show_hours %]
            [% INCLUDE 'opac/parts/footer/links.tt2' %]
        </div>

        [% INCLUDE 'opac/parts/footer/utility_bar.tt2' %]

        [% IF ctx.timing %]
        <div id="timing">
            [% FOR event IN ctx.timing %]
            At <span class="timing-time">[% event.0 | format("%0.4f") %]</span>:
            <span class="timing-event">[% event.1 %]</span><br />
            [% END %]
        </div>
        [% END %]

    </div>
</footer>
</div>
[% END %]
