[% IF ctx.get_org_setting(ctx.physical_loc || ctx.aou_tree.id, 'opac.stackmap_enable');
    mystackmapcode = ctx.get_org_setting(ctx.physical_loc || ctx.aou_tree.id, 'opac.stackmap_identifier'); %]
<script src="https://www.stackmapintegration.com/[% mystackmapcode %]/StackMap.min.js" type="text/javascript"></script>
<link rel="stylesheet" media="all" type="text/css" href="https://www.stackmapintegration.com/[% mystackmapcode %]/StackMap.min.css" />
[% END %]